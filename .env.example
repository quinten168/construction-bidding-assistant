# ============================================================================
# CANONICAL environment file for csi-bid-intelligence. Every key used anywhere
# in the repo is listed here, even the ones only a couple of scripts touch.
#
#   cp .env.example .env      then fill in the values below.
#
# This is THE place for shared credentials. apps/api/.env exists only for
# API-specific overrides and must NOT carry a second copy of the DSN --
# two copies drift, and the backend warns at startup if it finds one.
#
# Loaded by:
#   apps/api/backend/config.py        (resolved from __file__, not cwd)
#   pipelines/ci_model/06_reporting/agent/orchestrator.py
#   apps/web/next.config.ts           (dotenv; backfills NEXT_PUBLIC_* / BIDINTEL_API_URL
#                                       below without overriding apps/web/.env.local if present)
#
# For data/*.py, pipelines/plan_reader/04_tools/*.py, and pipelines/plan_reader/
# 01_pipeline/*.py run standalone (outside apps/api) -- these read os.environ
# directly and load no file -- export it into your shell first:
#
#   set -a; source .env; set +a
# ============================================================================

# Anthropic key for the chat agent and both extraction passes.
ANTHROPIC_API_KEY='sk-ant-...'

# Postgres DSN for the csi_team login (Supabase) — read/write on the `scratch`
# schema. Powers the bid-results / pit-list / competitor-registry admin pages
# and, from 2026-08-03, the plan-reader write path.
# Ask Tobias for the password. See docs/DATA_ACCESS.md.
SUPABASE_TEAM_DB_URL='postgresql://csi_team.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres'

# Server-side Google key for the reverse-geocode stage (city for
# project_natural_key). MUST NOT be the same value as
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, which the pit-list page ships to the browser.
# Unset simply disables the stage (null city), it does not error.
GOOGLE_GEOCODING_API_KEY=''

# --- apps/web -----------------------------------------------------------
# Google Maps: powers the pit-list page's coordinate->county/state auto-fill
# and the interactive map (both call Google directly from the browser, see
# docs/ARCHITECTURE.md §9). This is a public, referrer-restricted key, not a
# secret -- get one from console.cloud.google.com (enable "Maps JavaScript
# API" + "Geocoding API", restrict by HTTP referrer). Loaded here by
# apps/web/next.config.ts; put a different value in apps/web/.env.local if a
# teammate needs a per-machine override.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=''

# Backend URL override for apps/web (default http://127.0.0.1:8010 -- see
# apps/web/src/app/api/*/route.ts). Leave unset to use the default.
# BIDINTEL_API_URL=

# --- pipelines/plan_reader/04_tools/publish_to_supabase.py + inspect_supabase.py ---
# These two are the ONLY consumers of the two keys below. Not needed to run
# the app -- only for manually publishing/inspecting the analytical snapshot.

# Absolute path to the local csi_v2.db (the operational SQLite store).
# Read by publish_to_supabase.py, which opens it strictly read-only.
CSI_V2_DB='/absolute/path/to/csi_v2.db'

# Postgres DSN for the published analytical snapshot (Supabase) -- DISTINCT
# from SUPABASE_TEAM_DB_URL above (different role, different schema: this one
# is the `public` published-snapshot role, not the `scratch` read/write one).
# Needed only for a real publish; --dry-run works without it. See docs/DATA_ACCESS.md.
SUPABASE_DB_URL='postgresql://user:password@host:5432/postgres'
