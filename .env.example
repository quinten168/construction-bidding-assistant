# ============================================================================
# CANONICAL environment file for csi-bid-intelligence.
#
#   cp .env.example .env      then fill in the values below.
#
# This is THE place for shared credentials. apps/api/.env exists only for
# API-specific overrides and must NOT carry a second copy of the DSN --
# two copies drift, and the backend warns at startup if it finds one.
#
# Loaded by:
#   apps/api/backend/config.py        (resolved from __file__, not cwd)
#   pipelines/ci_model/06_reporting/agent/orchestrator.py
#
# For data/*.py and pipelines/plan_reader/04_tools/*.py, which read os.environ
# directly and load no file, export it into your shell first:
#
#   set -a; source .env; set +a
# ============================================================================

# Anthropic key for the chat agent and both extraction passes.
ANTHROPIC_API_KEY='sk-ant-...'

# Postgres DSN for the csi_team login (Supabase) — read/write on the `scratch`
# schema. Powers the bid-results / pit-list / competitor-registry admin pages
# and, from 2026-08-03, the plan-reader write path.
# Ask Tobias for the password. See docs/DATA_ACCESS.md.
SUPABASE_TEAM_DB_URL='postgresql://csi_team.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres'

# Server-side Google key for the reverse-geocode stage (city for
# project_natural_key). MUST NOT be the same value as
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, which the pit-list page ships to the browser.
# Unset simply disables the stage (null city), it does not error.
GOOGLE_GEOCODING_API_KEY=''
