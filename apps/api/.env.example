# Bid Assistant — environment template. Copy to .env (local) or set in Railway (deploy).
# If unset, the app falls back to the existing plan_reader/.env for the Anthropic key.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# BID_CHAT_MODEL=claude-sonnet-4-6
# BID_REWRITE_MODEL=claude-sonnet-4-6
# BID_RETRIEVE_K=6
# BID_MAX_HISTORY=8
# BID_ANSWER_MAX_TOKENS=900

# Postgres DSN for the csi_team login (Supabase) — powers the bid-results/pit-list/competitor-
# registry admin endpoints (backend/ci_db.py), read/write on the `scratch` schema. Same DSN as
# data/.env's SUPABASE_TEAM_DB_URL. Password sent separately — ask Tobias if you don't have it.
# See docs/DATA_ACCESS_SCRATCH.md.
# SUPABASE_TEAM_DB_URL lives in the repo-root .env (canonical), NOT here.
# Two copies of a DSN drift; the backend warns at startup if it finds one.
