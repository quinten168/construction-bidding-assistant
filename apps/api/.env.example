# Bid Assistant — environment template. Copy to .env (local) or set in Railway (deploy).
# If unset, the app falls back to the existing plan_reader/.env for the Anthropic key.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# BID_CHAT_MODEL=claude-sonnet-4-6
# BID_REWRITE_MODEL=claude-sonnet-4-6
# BID_RETRIEVE_K=6
# BID_MAX_HISTORY=8
# BID_ANSWER_MAX_TOKENS=900
