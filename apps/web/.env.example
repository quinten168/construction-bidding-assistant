# apps/web — environment template. Copy to .env.local (gitignored; Next.js loads it automatically).

# Google Maps: powers the pit-list page's coordinate->county/state auto-fill and the interactive
# map (both call Google directly from the browser, see docs/ARCHITECTURE.md §9). Get one from
# console.cloud.google.com: enable "Maps JavaScript API" + "Geocoding API", then restrict the key
# by HTTP referrer (e.g. http://localhost:3000/*) — this is a public, referrer-restricted key, not
# a secret, since the browser must send it with every Maps request.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend URL override (default http://127.0.0.1:8010 — see apps/web/src/app/api/*/route.ts)
# BIDINTEL_API_URL=
