ANTHROPIC_API_KEY='sk-ant-your-key-here'

# Absolute path to the local csi_v2.db (the operational SQLite store).
# Read by 04_tools/publish_to_supabase.py, which opens it strictly read-only.
CSI_V2_DB='/absolute/path/to/csi_v2.db'

# Postgres DSN for the published analytical snapshot (Supabase).
# Needed only for a real publish; --dry-run works without it. See docs/DATA_ACCESS.md.
SUPABASE_DB_URL='postgresql://user:password@host:5432/postgres'
